# Get a Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: choose a model supported by your account
GEMINI_MODEL=gemini-3.8-flash

# Speed: keep thinking low for quick replies (use "medium" or "high" for deeper plans)
GEMINI_THINKING_LEVEL=low

# Output limits: chat answers vs. long outputs (7-day plan, resume feedback)
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_LONG_OUTPUT_TOKENS=6000

# Optional: your own backup models, comma-separated.
# Leave this line out (or empty) and the app picks backups automatically from Google's list.
# GEMINI_FALLBACK_MODELS=gemini-3.8-flash-lite

# Local persistent app data file
DATA_FILE=data/app_data.json